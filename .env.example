# Cloudflare Calls (Anycast WebRTC SFU) Configuration
# 1. Login to https://dash.cloudflare.com/
# 2. In the left navigation, click "Calls"
# 3. Click "Create App", give it a name (e.g. "meet-io")
# 4. Copy the App ID and App Secret Key below:

CLOUDFLARE_APP_ID=
CLOUDFLARE_APP_SECRET=

# Server Port
PORT=3000
